# Supabase (Usar a chave Service Role no Back-end para ignorar RLS com segurança)
SUPABASE_URL="[https://seu-projeto.supabase.co](https://seu-projeto.supabase.co)"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-secreta-service-role"

# Resend (Disparo de E-mails)
RESEND_API_KEY="re_123456789"

# Senha do Painel do Organizador (/admin)
ADMIN_PASSWORD="sua-senha-segura-aqui"

# URL Pública do Site (Para montar os links no E-mail e WhatsApp)
NEXT_PUBLIC_APP_URL="[https://seu-projeto.vercel.app](https://seu-projeto.vercel.app)"